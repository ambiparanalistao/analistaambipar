# Configurações de Conexão com o Supabase Externo
VITE_SUPABASE_URL=https://seu-id-de-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui

# Server only — never prefix Evolution credentials with VITE_ or NEXT_PUBLIC_.
